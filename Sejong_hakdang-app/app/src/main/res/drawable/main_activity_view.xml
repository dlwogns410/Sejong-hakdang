<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FFFFFF" /> <!-- 흰색 배경 -->

    <stroke
        android:width="1dp"
        android:color="#CCCCCC" /> <!-- 회색 테두리 -->

    <corners android:radius="16dp" /> <!-- 둥근 모서리 -->

    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>